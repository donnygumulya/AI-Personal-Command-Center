{
  "name": "AIPCC - Task Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "6b1f0c1e-3a55-4c1e-9d0a-1f2e3d4c5b01",
      "name": "Every 5 Minutes"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tasks\nSET reminded_at = now(), updated_at = now()\nWHERE status = 'pending'\n  AND reminded_at IS NULL\n  AND due_at IS NOT NULL\n  AND due_at > now() - interval '15 minutes'\n  AND due_at <= now() + interval '1 hour'\nRETURNING id, telegram_chat_id, title, description, due_at;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "6b1f0c1e-3a55-4c1e-9d0a-1f2e3d4c5b02",
      "name": "Claim Due Reminders",
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "6b1f0c1e-3a55-4c1e-9d0a-1f2e3d4c5b11",
              "leftValue": "={{ !!$json.telegram_chat_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "id": "6b1f0c1e-3a55-4c1e-9d0a-1f2e3d4c5b04",
      "name": "Any Due?"
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=⏰ Reminder: {{ $json.title }}\nDue {{ new Date($json.due_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }) }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        -16
      ],
      "id": "6b1f0c1e-3a55-4c1e-9d0a-1f2e3d4c5b03",
