    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.output[0].content[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { intent: 'unknown', title: null, description: null, due_at: null, query_date: null };\n}\n\nlet range_start, range_end;\nif (parsed.query_date) {\n  const start = new Date(parsed.query_date + 'T00:00:00+07:00');\n  range_start = start.toISOString();\n  range_end = new Date(start.getTime() + 24 * 60 * 60 * 1000).toISOString();\n} else {\n  range_start = new Date().toISOString();\n  range_end = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString();\n}\n\nreturn {\n  json: {\n    ...parsed,\n    telegram_chat_id: $('Telegram Trigger').item.json.message.chat.id,\n    original_message: $('Telegram Trigger').item.json.message.text,\n    range_start,\n    range_end\n  }\n};"
      },
