      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, description, due_at\nFROM tasks\nWHERE telegram_chat_id = {{ $('Parse Intent Response').item.json.telegram_chat_id }}\n  AND status = 'pending'\n  {{ $('Parse Intent Response').item.json.query_date\n      ? `AND due_at >= '${$('Parse Intent Response').item.json.range_start}' AND due_at < '${$('Parse Intent Response').item.json.range_end}'`\n      : `AND (due_at IS NULL OR due_at >= '${$('Parse Intent Response').item.json.range_start}')` }}\nORDER BY due_at ASC NULLS LAST, created_at ASC;",
        "options": {}
