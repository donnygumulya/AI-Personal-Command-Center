    {
      "parameters": {
        "jsCode": "const issues = $input.all().map(i => i.json).filter(i => i && i.key);\nconst intent = $('Parse Intent Response').item.json.intent;\nconst header = intent === 'jira_blocked' ? '🚧 Blocked / high-priority issues:' : '🎫 Your open issues:';\n\nif (issues.length === 0) {\n  return [{ json: { reply_text: intent === 'jira_blocked' ? 'Nothing blocked. 🎉' : 'No open Jira issues assigned to you. 🎉' } }];\n}\n\nconst lines = issues.map((i, n) => {\n  const f = i.fields || {};\n  const meta = [f.status?.name, f.priority?.name].filter(Boolean).join(', ');\n  return `${n + 1}. ${i.key} ${f.summary} [${meta}]${f.duedate ? ` (due ${f.duedate})` : ''}`;\n});\n\nreturn [{ json: { reply_text: `${header}\\n\\n${lines.join('\\n')}` } }];"
      },
