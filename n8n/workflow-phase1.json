    {
      "parameters": {
        "jsCode": "const events = $input.all().map(item => item.json).filter(ev => ev && ev.id);\nconst queryDate = $('Parse Intent Response').item.json.query_date;\nconst header = queryDate ? `📅 Events on ${queryDate}:` : '📅 Upcoming events:';\n\nif (events.length === 0) {\n  return [{\n    json: {\n      reply_text: queryDate\n        ? `Nothing on your calendar for ${queryDate}. 🎉`\n        : \"Nothing on your calendar for the next 7 days. 🎉\"\n    }\n  }];\n}\n\nconst lines = events.map((ev, i) => {\n  const start = ev.start?.dateTime || ev.start?.date;\n  const when = start\n    ? new Date(start).toLocaleString('en-GB', {\n        dateStyle: 'medium',\n        timeStyle: 'short',\n        timeZone: 'Asia/Jakarta'\n      })\n    : 'No time set';\n  return `${i + 1}. ${ev.summary || '(no title)'} — ${when}`;\n});\n\nreturn [{ json: { reply_text: `${header}\\n\\n${lines.join('\\n')}` } }];"
      },
