    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json).filter(row => row && row.id);\nconst queryDate = $('Parse Intent Response').item.json.query_date;\nconst header = queryDate ? `📋 Tasks due ${queryDate}:` : '📋 Your pending tasks:';\n\nif (rows.length === 0) {\n  return [{ json: { reply_text: queryDate ? `Nothing due on ${queryDate}. 🎉` : \"You've got no pending tasks. 🎉\" } }];\n}\n\nconst lines = rows.map((row, i) => {\n  const due = row.due_at\n    ? new Date(row.due_at).toLocaleString('en-GB', {\n        dateStyle: 'medium',\n        timeStyle: 'short',\n        timeZone: 'Asia/Jakarta'\n      })\n    : null;\n  return `${i + 1}. ${row.title}${due ? ` — due ${due}` : ''}`;\n});\n\nreturn [{ json: { reply_text: `${header}\\n\\n${lines.join('\\n')}` } }];"
      },
